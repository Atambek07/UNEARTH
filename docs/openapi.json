  "components": {
    "schemas": {
      "CarbonRequest": {
        "properties": {
          "monthly_ch4_m3_delivered": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "minItems": 12,
            "title": "Monthly Ch4 M3 Delivered",
            "description": "Уничтоженный CH4 по месяцам, м³ (длина кратна 12)"
          },
          "gwp": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Gwp",
            "default": 28.0
          },
          "buffer_share": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "minimum": 0.0,
            "title": "Buffer Share",
            "default": 0.2
          },
          "verification_lag_months": {
            "type": "integer",
            "maximum": 36.0,
            "minimum": 0.0,
            "title": "Verification Lag Months",
            "default": 12
          },
          "price_p10": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Price P10",
            "default": 8.0
          },
          "price_p50": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Price P50",
            "default": 15.0
          },
          "price_p90": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Price P90",
            "default": 25.0
          },
          "validation_cost_usd": {
            "type": "number",
            "minimum": 0.0,
            "title": "Validation Cost Usd",
            "default": 25000.0
          },
          "verification_cost_usd_year": {
            "type": "number",
            "minimum": 0.0,
            "title": "Verification Cost Usd Year",
            "default": 12000.0
          },
          "monitoring_cost_usd_year": {
            "type": "number",
            "minimum": 0.0,
            "title": "Monitoring Cost Usd Year",
            "default": 8000.0
          },
          "issuance_fee_usd_per_credit": {
            "type": "number",
            "minimum": 0.0,
            "title": "Issuance Fee Usd Per Credit",
            "default": 0.1
          },
          "discount_rate": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Discount Rate",
            "default": 0.1
          }
        },
        "type": "object",
        "required": [
          "monthly_ch4_m3_delivered"
        ],
        "title": "CarbonRequest",
        "description": "Карбоновый модуль (CDM ACM0001): параметры кредита и базовая линия."
      },
      "CurrencyRequest": {
        "properties": {
          "usd_kgs_rate": {
            "type": "number",
            "maximum": 1000.0,
            "exclusiveMinimum": 0.0,
            "title": "Usd Kgs Rate",
            "default": 87.4
          },
          "conversion_spread": {
            "type": "number",
            "maximum": 0.2,
            "minimum": 0.0,
            "title": "Conversion Spread",
            "default": 0.015
          },
          "repatriation_share": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Repatriation Share",
            "default": 1.0
          },
          "repatriation_cost_share": {
            "type": "number",
            "maximum": 0.2,
            "minimum": 0.0,
            "title": "Repatriation Cost Share",
            "default": 0.005
          },
          "hedging_cost_share": {
            "type": "number",
            "maximum": 0.2,
            "minimum": 0.0,
            "title": "Hedging Cost Share",
            "default": 0.01
          },
          "annual_usd": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Annual Usd"
          }
        },
        "type": "object",
        "required": [
          "annual_usd"
        ],
        "title": "CurrencyRequest",
        "description": "Валютный расчёт по годам: конвертация, репатриация, хеджирование."
      },
      "FinanceRequest": {
        "properties": {
          "horizon_years": {
            "type": "integer",
            "maximum": 25.0,
            "minimum": 3.0,
            "title": "Horizon Years"
          },
          "monthly_power_mw": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "minItems": 12,
            "title": "Monthly Power Mw"
          },
          "monthly_ch4_m3_delivered": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "minItems": 12,
            "title": "Monthly Ch4 M3 Delivered"
          },
          "miners_count": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Miners Count"
          },
          "ai_servers_count": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Ai Servers Count"
          },
          "btc_price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Btc Price",
            "default": 65000.0
          },
          "gpu_rent_usd_per_gpu_hour": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Gpu Rent Usd Per Gpu Hour",
            "default": 2.0
          },
          "opex_variable_annual_usd": {
            "type": "number",
            "minimum": 0.0,
            "title": "Opex Variable Annual Usd",
            "default": 0.0
          },
          "opex_fixed_annual_usd": {
            "type": "number",
            "minimum": 0.0,
            "title": "Opex Fixed Annual Usd",
            "default": 0.0
          },
          "seed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Seed",
            "default": 42
          },
          "n_sims": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 50.0,
            "title": "N Sims",
            "default": 400
          },
          "fiscal_regime": {
            "type": "string",
            "enum": [
              "none",
              "kr_general",
              "kr_htp",
              "kz_aifc"
            ],
            "title": "Fiscal Regime",
            "description": "Фискальный режим: none (pretax), kr_general (прибыль 10 % + майнинг-налог), kr_htp (резидент ПВТ), kz_aifc (Astana Hub, Казахстан — сравнение)",
            "default": "kr_htp"
          },
          "fx": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FxRequest"
              },
              {
                "type": "null"
              }
            ],
            "description": "Валютный блок; None — дефолтный курс и спреды"
          }
        },
        "type": "object",
        "required": [
          "horizon_years",
          "monthly_power_mw",
          "monthly_ch4_m3_delivered",
          "miners_count",
